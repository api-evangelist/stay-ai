          "http": {
            "method": "POST",
            "url": "https://api.retextion.com/api/v2/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create Webhook Subscription"
        },
        {
          "info": {
            "name": "Delete Webhook Subscription",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.retextion.com/api/v2/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete Webhook Subscription"
        }
      ]
    }
  ],
  "bundled": true
}